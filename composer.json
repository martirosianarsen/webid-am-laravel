{
    "name": "webid-am/laravel",
    "description": "Sign in with webid for Laravel sites: one connection key, the sign-in routes, users found or created, and webid's APIs.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://webid.am",
    "keywords": [
        "webid",
        "laravel",
        "openid-connect",
        "sso",
        "armenia"
    ],
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10|^7.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Webid\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webid\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webid\\Laravel\\WebidServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
